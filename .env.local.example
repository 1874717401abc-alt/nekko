# 复制本文件为 .env.local，并修改为团队自己的值。
# SESSION_SECRET 用于签名登录态，生产环境必须设置为长随机字符串。
SESSION_SECRET=replace-with-a-long-random-secret

# TEAM_INVITE_CODE 是成员注册邀请码。
TEAM_INVITE_CODE=replace-with-your-team-invite-code

# DeepSeek AI 助手配置。API Key 只放在服务器环境变量或 .env.local，不能提交到仓库。
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
