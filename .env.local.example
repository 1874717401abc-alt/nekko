# 复制本文件为 .env.local，并修改为团队自己的值。
# SESSION_SECRET 用于签名登录态，生产环境必须设置为长随机字符串。
SESSION_SECRET=replace-with-a-long-random-secret

# TEAM_INVITE_CODE 是成员注册邀请码。
TEAM_INVITE_CODE=replace-with-your-team-invite-code

# AI 助手配置。默认可直连 DeepSeek；线上推荐 AI_BACKEND=hermes，把 Hermes 作为本机 agent 网关。
AI_BACKEND=deepseek

# DeepSeek API Key 只放在服务器环境变量或 .env.local，不能提交到仓库。
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Hermes Agent 网关配置。Hermes API server 默认只监听服务器本机 127.0.0.1。
HERMES_API_BASE_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=replace-with-local-hermes-api-key
HERMES_MODEL=hermes-agent

# 内容雷达定时任务密钥。服务器 cron 调用 /api/ai/content-radar 时使用。
RADAR_CRON_SECRET=replace-with-a-long-random-radar-secret
